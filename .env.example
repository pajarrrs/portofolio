# Resend API key — set this in Vercel dashboard -> Project Settings -> Environment Variables
# NEVER commit the real value to the repo.
RESEND_API_KEY=

# Optional: override the destination inbox (defaults to pajarr2302@gmail.com)
CONTACT_TO=pajarr2302@gmail.com

# -------------------------------------------------------------
# TURSO SQLITE & CMS CONFIGURATION
# -------------------------------------------------------------
# Untuk deploy di Vercel: ambil dari dashboard turso.tech
# Jika dikosongkan saat pengujian lokal, sistem otomatis memakai local SQLite (local.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Password untuk masuk ke /admin (default lokal jika kosong: admin123)
ADMIN_PASSWORD=admin123
